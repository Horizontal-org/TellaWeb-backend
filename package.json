    "cookie-parser": "^1.4.5",
    "dotenv": "^18.0.6",
    "express-handlebars": "^7.0.7",
    "file-type": "^16.5.3",
    "fluent-ffmpeg": "^2.1.2",
    "heic-convert": "^2.1.0",
    "image-thumbnail": "^1.0.13",
